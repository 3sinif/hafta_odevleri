    <script>
        // CORE CONSTANTS
        const TOTAL_WEEKS = 36;
        const SUBJECTS_PER_WEEK = 4;
        const TOTAL_PAGES = TOTAL_WEEKS * SUBJECTS_PER_WEEK; // 144 Pages Total

        const SUBJECTS = [
            { id: 1, name: 'Türkçe', icon: 'fa-book-open', bgClass: 'bg-rose-500', textClass: 'text-rose-600', activeBorder: 'border-rose-500' },
            { id: 2, name: 'Matematik', icon: 'fa-calculator', bgClass: 'bg-sky-500', textClass: 'text-sky-600', activeBorder: 'border-sky-500' },
            { id: 3, name: 'Fen Bilimleri', icon: 'fa-flask', bgClass: 'bg-emerald-500', textClass: 'text-emerald-600', activeBorder: 'border-emerald-500' },
            { id: 4, name: 'Hayat Bilgisi', icon: 'fa-sun', bgClass: 'bg-amber-500', textClass: 'text-amber-600', activeBorder: 'border-amber-500' }
        ];

        const BASE_IMAGE_URL = 'https://www.kirmizibeyazyayincilik.com.tr/c/ebhaftaici3/';

        // STATE & SPEED CACHE
        let currentPage = 1;
        let zoomLevel = 1.0;
        let completedPages = new Set(JSON.parse(localStorage.getItem('zeki_sabah_completed') || '[]'));

        // Memory Cache for loaded Image Objects
        const memoryImageCache = new Map();
        let loadTimeoutTimer = null;

        // URL generator
        function getImageUrl(pageNum) {
            return `${BASE_IMAGE_URL}${pageNum}.jpg`;
        }

        // Get Page Details
        function getPageDetails(pageNum) {
            const week = Math.floor((pageNum - 1) / SUBJECTS_PER_WEEK) + 1;
            const subjectIndex = ((pageNum - 1) % SUBJECTS_PER_WEEK) + 1;
            const subject = SUBJECTS[subjectIndex - 1];
            return { week, subjectIndex, subject };
        }

        function getPageNumber(week, subjectIndex) {
            return ((week - 1) * SUBJECTS_PER_WEEK) + subjectIndex;
        }

        // Ultra-Fast Smart Preloader (Sequential, low priority)
        function preloadSinglePage(pageNum) {
            if (pageNum < 1 || pageNum > TOTAL_PAGES || memoryImageCache.has(pageNum)) return;

            const img = new Image();
            img.decoding = 'async';
            img.src = getImageUrl(pageNum);
            memoryImageCache.set(pageNum, img);
        }

        function triggerSmartPreload(centerPage) {
            // Priority: next page, previous page, next + 1, next + 2
            const queue = [centerPage + 1, centerPage - 1, centerPage + 2, centerPage + 3];
            queue.forEach(pNum => {
                if (pNum >= 1 && pNum <= TOTAL_PAGES) {
                    setTimeout(() => preloadSinglePage(pNum), 100);
                }
            });
        }

        // DOM INITIALIZATION
        window.addEventListener('DOMContentLoaded', () => {
            renderSubjectTabs();
            renderWeeksGrid();
            loadPage(currentPage);
            setupKeyboardListeners();
            setupTouchGestures();
        });

        function renderSubjectTabs() {
            const container = document.getElementById('subject-tabs-container');
            const { subjectIndex } = getPageDetails(currentPage);

            container.innerHTML = SUBJECTS.map((subj) => {
                const isActive = subj.id === subjectIndex;
                const styleClasses = isActive
                    ? `${subj.bgClass} text-white shadow-md font-black ring-2 ring-slate-800/20 scale-[1.01]`
                    : `bg-slate-50 hover:bg-slate-100 text-slate-700 border-slate-200 font-bold hover:border-slate-300`;

                return `
                    <button onclick="selectSubject(${subj.id})" 
                        class="subject-tab flex items-center justify-center gap-2 p-2.5 rounded-xl border text-xs sm:text-sm transition-all ${styleClasses}">
                        <i class="fa-solid ${subj.icon} ${isActive ? 'text-white' : subj.textClass}"></i>
                        <span>${subj.name}</span>
                    </button>
                `;
            }).join('');
        }

        function renderWeeksGrid() {
            const container = document.getElementById('weeks-grid-container');
            const { week: currentWeek } = getPageDetails(currentPage);

            let html = '';
            for (let w = 1; w <= TOTAL_WEEKS; w++) {
                const isCurrent = w === currentWeek;

                const isWeekDone = [1, 2, 3, 4].every(sIndex => {
                    return completedPages.has(getPageNumber(w, sIndex));
                });

                let buttonStyle = "bg-white hover:bg-slate-100 text-slate-800 border-slate-200";
                if (isCurrent) {
                    buttonStyle = "bg-indigo-600 text-white font-black shadow-lg border-indigo-600 ring-2 ring-indigo-200";
                } else if (isWeekDone) {
                    buttonStyle = "bg-emerald-50 text-emerald-800 border-emerald-300 hover:bg-emerald-100 font-bold";
                }

                html += `
                    <button onclick="jumpToWeek(${w})" class="p-2.5 rounded-2xl border flex flex-col items-center justify-center gap-1 transition-all hover:scale-105 active:scale-95 ${buttonStyle}">
                        <span class="text-[9px] uppercase font-bold opacity-75">Hafta</span>
                        <span class="text-lg font-black heading-font">${w}</span>
                        ${isWeekDone ? '<i class="fa-solid fa-circle-check text-emerald-500 text-xs"></i>' : ''}
                    </button>
                `;
            }
            container.innerHTML = html;
        }

        function loadPage(pageNumber) {
            if (pageNumber < 1) pageNumber = 1;
            if (pageNumber > TOTAL_PAGES) pageNumber = TOTAL_PAGES;

            currentPage = pageNumber;
            const { week, subjectIndex, subject } = getPageDetails(currentPage);
            const imgUrl = getImageUrl(currentPage);

            // INSTANT UI UPDATES (0ms delay)
            document.getElementById('current-week-title').innerText = `${week}. HAFTA ÖDEVİ`;
            document.getElementById('global-page-num').innerText = currentPage;
            document.getElementById('page-slider').value = currentPage;

            const activeBadge = document.getElementById('active-subject-badge');
            activeBadge.innerText = `${subjectIndex}. Ders: ${subject.name}`;
            activeBadge.className = `px-3 py-1 rounded-lg text-xs font-black text-white ${subject.bgClass} shadow-sm`;

            document.getElementById('chk-completed').checked = completedPages.has(currentPage);

            document.getElementById('btn-prev-week').disabled = (week === 1);
            document.getElementById('btn-next-week').disabled = (week === TOTAL_WEEKS);
            document.getElementById('btn-page-prev').disabled = (currentPage === 1);
            document.getElementById('btn-page-next').disabled = (currentPage === TOTAL_PAGES);

            renderSubjectTabs();

            // Clear any old slow-network timer
            if (loadTimeoutTimer) clearTimeout(loadTimeoutTimer);
            document.getElementById('image-error').classList.add('hidden');

            const imgElement = document.getElementById('worksheet-img');
            const skeleton = document.getElementById('image-skeleton');
            document.getElementById('skeleton-sub-text').innerText = `${week}. Hafta - ${subject.name}`;
            document.getElementById('direct-image-link').href = imgUrl;

            // Check if image is already cached in browser memory
            let cachedImg = memoryImageCache.get(currentPage);
            if (cachedImg && cachedImg.complete && cachedImg.naturalWidth !== 0) {
                // INSTANT 0-MS RENDER FROM CACHE
                imgElement.src = cachedImg.src;
                imgElement.style.opacity = '1';
                skeleton.style.opacity = '0';
                skeleton.style.pointerEvents = 'none';
            } else {
                // Show Skeleton shimmer behind, set src asynchronously
                imgElement.style.opacity = '0';
                skeleton.style.opacity = '1';
                skeleton.style.pointerEvents = 'auto';

                imgElement.src = imgUrl;

                // Set 3.5s timeout for slow network warning fallback
                loadTimeoutTimer = setTimeout(() => {
                    if (imgElement.style.opacity === '0') {
                        document.getElementById('image-error').classList.remove('hidden');
                    }
                }, 3500);
            }

            // Trigger background preloading for nearby pages
            triggerSmartPreload(currentPage);
            resetZoom();
        }

        function onImageLoaded() {
            if (loadTimeoutTimer) clearTimeout(loadTimeoutTimer);
            const imgElement = document.getElementById('worksheet-img');
            const skeleton = document.getElementById('image-skeleton');

            imgElement.style.opacity = '1';
            skeleton.style.opacity = '0';
            skeleton.style.pointerEvents = 'none';

            // Save to memory cache
            if (!memoryImageCache.has(currentPage)) {
                memoryImageCache.set(currentPage, imgElement.cloneNode());
            }
        }

        function onImageError() {
            if (loadTimeoutTimer) clearTimeout(loadTimeoutTimer);
            document.getElementById('image-error').classList.remove('hidden');
        }

        function reloadImage() {
            loadPage(currentPage);
        }

        function navigatePage(delta) {
            loadPage(currentPage + delta);
        }

        function selectSubject(subjectId) {
            const { week } = getPageDetails(currentPage);
            loadPage(getPageNumber(week, subjectId));
        }

        function changeWeek(delta) {
            const { week, subjectIndex } = getPageDetails(currentPage);
            const targetWeek = week + delta;
            if (targetWeek >= 1 && targetWeek <= TOTAL_WEEKS) {
                loadPage(getPageNumber(targetWeek, subjectIndex));
            }
        }

        function jumpToWeek(weekNumber) {
            closeWeekModal();
            loadPage(getPageNumber(weekNumber, 1)); // Default to Türkçe
        }

        function onSliderChange(val) {
            loadPage(parseInt(val, 10));
        }

        function toggleCompleted() {
            const isChecked = document.getElementById('chk-completed').checked;
            if (isChecked) {
                completedPages.add(currentPage);
            } else {
                completedPages.delete(currentPage);
            }
            localStorage.setItem('zeki_sabah_completed', JSON.stringify(Array.from(completedPages)));
            renderWeeksGrid();
        }

        // ZOOM CONTROLS
        function zoomSheet(delta) {
            zoomLevel = Math.max(0.6, Math.min(2.5, zoomLevel + delta));
            applyZoom();
        }

        function resetZoom() {
            zoomLevel = 1.0;
            applyZoom();
        }

        function applyZoom() {
            const wrapper = document.getElementById('image-transform-wrapper');
            wrapper.style.transform = `scale(${zoomLevel})`;
            document.getElementById('zoom-indicator').innerText = `${Math.round(zoomLevel * 100)}%`;
        }

        function openImageNewTab() {
            window.open(getImageUrl(currentPage), '_blank');
        }

        function printWorksheet() {
            const printImg = document.getElementById('print-img');
            printImg.src = getImageUrl(currentPage);
            setTimeout(() => {
                window.print();
            }, 300);
        }

        function toggleFullscreen() {
            const viewport = document.getElementById('sheet-viewport');
            if (!document.fullscreenElement) {
                viewport.requestFullscreen().catch(() => { });
            } else {
                document.exitFullscreen();
            }
        }

        // MODALS
        function openWeekModal() {
            renderWeeksGrid();
            document.getElementById('week-modal').classList.remove('hidden');
        }

        function closeWeekModal() {
            document.getElementById('week-modal').classList.add('hidden');
        }

        // KEYBOARD & TOUCH LISTENERS
        function setupKeyboardListeners() {
            document.addEventListener('keydown', (e) => {
                if (!document.getElementById('week-modal').classList.contains('hidden')) {
                    if (e.key === 'Escape') closeWeekModal();
                    return;
                }

                if (e.key === 'ArrowLeft') {
                    navigatePage(-1);
                } else if (e.key === 'ArrowRight') {
                    navigatePage(1);
                } else if (e.key === '+' || e.key === '=') {
                    zoomSheet(0.15);
                } else if (e.key === '-') {
                    zoomSheet(-0.15);
                } else if (e.key === '0') {
                    resetZoom();
                }
            });
        }

        function setupTouchGestures() {
            const viewport = document.getElementById('sheet-viewport');
            let touchStartX = 0;
            let touchEndX = 0;

            viewport.addEventListener('touchstart', (e) => {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            viewport.addEventListener('touchend', (e) => {
                touchEndX = e.changedTouches[0].screenX;
                const distance = touchEndX - touchStartX;
                if (Math.abs(distance) > 55) {
                    if (distance > 0) navigatePage(-1);
                    else navigatePage(1);
                }
            }, { passive: true });
        }
    </script>
</body>

</html>
